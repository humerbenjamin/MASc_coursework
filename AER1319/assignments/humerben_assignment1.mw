<Group hide-input="false" labelreference="L26" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Font size="18" underline="true" style="Text" bold="true" executable="true"># Set up input vectors representing 2-D inviscid Euler equations</Font>
</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">W:=array(1..4, [rho, u, v, p]);</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">U:=array(1..4, [rho, rho*u, rho*v, (p/(g-1)) + (rho * (u^2 + v^2))/2]);</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">F:=array(1..4, [rho*u, rho*u^2+p, rho*u*v, rho*u*((g*p)/((g-1)*rho) + (u^2+v^2)/2)]);</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">G:=array(1..4, [rho*v, rho*u*v, rho*v^2 + p, rho*v*((g*p)/((g-1)*rho) + (u^2+v^2)/2)]);</Text-field>
</Input>
